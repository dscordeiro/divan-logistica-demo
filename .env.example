# Copie para .env e ajuste. Em uso local nada aqui é obrigatório.

# Porta e endereço público (usado nos links copiados e nos QR Codes)
PORT=3000
APP_URL=http://localhost:3000

# Produção: defina NODE_ENV=production e um segredo longo (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NODE_ENV=production
# APP_SECRET=

# Banco: vazio = banco embutido na pasta data/ (não precisa instalar nada)
# Para PostgreSQL: postgres://usuario:senha@localhost:5432/divan_links
# DATABASE_URL=

# Primeiro administrador (criado só se não existir nenhum usuário)
ADMIN_EMAIL=daniel@agencialeaf.com.br
ADMIN_NAME=Daniel Cordeiro
# ADMIN_PASSWORD=   (vazio = gera uma senha e salva em data/PRIMEIRO-ACESSO.txt)

# Verificação em duas etapas obrigatória para administradores (padrão: true em produção)
# REQUIRE_2FA=true

# Restringir o painel a alguns IPs (separados por vírgula; * no fim para faixa)
# ADMIN_ALLOWED_IPS=177.10.20.*,200.1.2.3

# Atrás de proxy (Caddy, Nginx, cPanel): mantém true para ler o IP real do visitante
TRUST_PROXY=true

# Geolocalização: arquivo .mmdb (DB-IP Lite ou MaxMind GeoLite2). Padrão: data/geo.mmdb
# GEOIP_DB=data/geo.mmdb
